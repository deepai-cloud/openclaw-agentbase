{
  "gateway": {
    "mode": "local",
    "auth": { "mode": "token" },
    "controlUi": {
      "allowedOrigins": [
        "http://localhost:18789",
        "http://127.0.0.1:18789"
      ]
    }
  },
  "tools": {
    "profile": "coding",
    "alsoAllow": ["browser"]
  },
  "browser": {
    "enabled": true,
    "defaultProfile": "openclaw",
    "headless": true,
    "noSandbox": false,
    "executablePath": "/usr/local/bin/chromium"
  }
}
